# General settings
PUBLIC_URL=<https://JITSI_ADDRESS>
DOCKER_HOST_ADDRESS=<PUBLIC IP>
AUTH_TYPE=jwt
ENABLE_AUTH=1
ENABLE_GUESTS=0
ENABLE_AUTO_LOGIN=0
JWT_ALLOW_EMPTY=0
ENABLE_COLIBRI_WEBSOCKET=1

# Keycloak
KEYCLOAK_ADAPTER_URL=<https://JITSI_ADAPTER_ADDRESS>/{room}

# JWT settings (must be the same across the adapter + Jitsi + Prosody)
JWT_APP_ID=jitsi
JWT_APP_SECRET=MySuperStrongSecretKey123

# Jicofo (focus) user credentials
JICOFO_USER=focus
JICOFO_PASSWORD=JicofoPass123!
JICOFO_COMPONENT_SECRET=JicofoCompPass123!

# Videobridge (JVB) user credentials
JVB_USER=jvb
JVB_PASSWORD=JvbPass123!
JVB_COMPONENT_SECRET=JvbCompPass123!
